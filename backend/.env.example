# Local development only. Copy to .env; do not commit .env.
# Replace this placeholder with a locally generated key (see README.md).
SECRET_KEY=replace_with_a_generated_local_key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SQLite needs no separate database server. Leave DB_NAME unset for the default
# backend/db.sqlite3. Do not use an empty DB_NAME value.
DB_ENGINE=django.db.backends.sqlite3

# When PostgreSQL is ready, REPLACE DB_ENGINE above and uncomment these values.
# Use the credentials supplied by the database teammate.
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=adoption_db
# DB_USER=adoption_app
# DB_PASSWORD=replace_with_your_local_database_password
# DB_HOST=127.0.0.1
# DB_PORT=5432
